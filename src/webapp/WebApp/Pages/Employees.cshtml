@page "/"
@model WebApp.Api.Pages.EmployeesModel
@{ ViewData["Title"] = "Employees"; }

<div class="emp-header">
    <div>
        <h1 class="emp-title">Employees</h1>
        <span class="emp-subtitle" id="totalCount">Loading...</span>
    </div>
    <div class="emp-actions">
        <button class="btn-icon" onclick="exportPDF()">Export PDF</button>
        <button class="btn-primary" onclick="openCreate()">+ Add Employee</button>
    </div>
</div>

<div class="emp-toolbar">
    <div class="search-box">
        <input type="text" id="searchInput" placeholder="Search employees…" autocomplete="off">
    </div>
</div>

<div class="chart-section">
    <div class="chart-label">Employees by Department</div>
    <div class="chart-wrap"><canvas id="employeeChart"></canvas></div>
</div>

<div class="emp-table-wrap">
    <table class="emp-table">
        <thead>
            <tr>
                <th class="sortable" data-column="EmployeeID">ID</th>
                <th class="sortable" data-column="FullName">Name</th>
                <th class="sortable" data-column="Position">Position</th>
                <th class="sortable" data-column="Department">Department</th>
                <th class="sortable" data-column="HireDate">Hired</th>
                <th>Contacts</th>
                <th class="sortable" data-column="Salary">Salary</th>
                <th>File</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="employeesTableBody"></tbody>
    </table>
</div>

<div class="emp-pagination">
    <ul id="paginationControls"></ul>
</div>

<div class="modal-backdrop" id="modalBackdrop" onclick="closeModal()"></div>
<div class="side-modal" id="sideModal">
    <div class="side-modal-header">
        <h2 id="modalTitle">Add Employee</h2>
        <button class="close-btn" onclick="closeModal()">&#x2715;</button>
    </div>
    <form id="employeeForm" onsubmit="saveEmployee(event)">
        <input type="hidden" id="employeeId">
        <div class="side-modal-body">
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" id="fullName" placeholder="John Smith" required>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Position</label>
                    <input type="text" id="position" placeholder="Software Engineer" required>
                </div>
                <div class="form-group">
                    <label>Department</label>
                    <input type="text" id="department" placeholder="Engineering" required>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Hire Date</label>
                    <input type="date" id="hireDate" required>
                </div>
                <div class="form-group">
                    <label>Salary ($)</label>
                    <input type="number" step="0.01" id="salary" placeholder="0.00">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="email" placeholder="john@example.com">
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <input type="tel" id="phone" placeholder="+1 555 000 0000">
                </div>
            </div>
            <div class="form-group">
                <label>Document <span class="label-hint">(optional, max 5 MB)</span></label>
                <div class="file-drop" id="fileDrop" onclick="document.getElementById('fileInput').click()">
                    <span id="fileLabel">Click to upload PDF, JPG or PNG</span>
                </div>
                <input type="file" id="fileInput" accept=".pdf,.jpg,.jpeg,.png" style="display:none" onchange="onFileSelected(this)">
                <div id="existingFileBar" class="existing-file-bar" style="display:none">
                    <span class="file-attached-label">File attached</span>
                    <button type="button" class="btn-remove-file" onclick="markFileForDeletion()">Remove</button>
                </div>
                <input type="hidden" id="deleteFile" value="false">
            </div>
        </div>
        <div class="side-modal-footer">
            <button type="button" class="btn-ghost" onclick="closeModal()">Cancel</button>
            <button type="submit" class="btn-primary">Save</button>
        </div>
    </form>
</div>

<div id="toast"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/employees.js"></script>
    <style>
        body { background:#f7f8fa; }

        .emp-header { display:flex; align-items:center; justify-content:space-between; padding:28px 0 18px; }
        .emp-title { font-size:1.55rem; font-weight:700; color:#0f172a; margin:0; }
        .emp-subtitle { font-size:.82rem; color:#94a3b8; }
        .emp-actions { display:flex; gap:8px; }

        .btn-primary { background:#2563eb; color:#fff; border:none; padding:9px 18px; border-radius:8px; font-size:.875rem; font-weight:600; cursor:pointer; }
        .btn-primary:hover { background:#1d4ed8; }
        .btn-icon { background:#fff; color:#475569; border:1px solid #e2e8f0; padding:9px 16px; border-radius:8px; font-size:.875rem; font-weight:500; cursor:pointer; }
        .btn-icon:hover { background:#f8fafc; }
        .btn-ghost { background:transparent; color:#475569; border:1px solid #e2e8f0; padding:9px 18px; border-radius:8px; font-size:.875rem; font-weight:500; cursor:pointer; }
        .btn-ghost:hover { background:#f1f5f9; }

        .emp-toolbar { margin-bottom:14px; }
        .search-box { display:flex; align-items:center; background:#fff; border:1px solid #e2e8f0; border-radius:8px; padding:9px 14px; width:320px; }
        .search-box input { border:none; outline:none; background:transparent; font-size:.875rem; width:100%; color:#0f172a; }

        .chart-section { background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:18px 20px 14px; margin-bottom:16px; }
        .chart-label { font-size:.72rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.06em; margin-bottom:10px; }
        .chart-wrap { position:relative; height:160px; }

        .emp-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; }
        .emp-table { width:100%; border-collapse:collapse; font-size:.875rem; }
        .emp-table thead th { padding:11px 16px; text-align:left; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#94a3b8; background:#fafafa; border-bottom:1px solid #f1f5f9; }
        .emp-table thead th.sortable { cursor:pointer; }
        .emp-table thead th.sortable:hover { color:#2563eb; }
        .emp-table tbody td { padding:14px 16px; border-bottom:1px solid #f8fafc; vertical-align:middle; color:#374151; }
        .emp-table tbody tr:last-child td { border-bottom:none; }
        .emp-table tbody tr:hover td { background:#fafafe; }
        .fw-name { font-weight:600; color:#0f172a; }
        .badge-pos { display:inline-block; padding:3px 10px; border-radius:20px; background:#eff6ff; color:#2563eb; font-size:.75rem; font-weight:600; }
        .text-sm { font-size:.78rem; color:#6b7280; }

        .act-btn { padding:6px 9px; border-radius:6px; border:none; cursor:pointer; background:transparent; color:#94a3b8; line-height:1; }
        .act-btn:hover { background:#f1f5f9; color:#374151; }
        .act-btn.danger:hover { background:#fee2e2; color:#dc2626; }

        .emp-pagination { padding:16px 0; display:flex; justify-content:center; }
        #paginationControls { list-style:none; display:flex; gap:4px; padding:0; margin:0; }
        #paginationControls li a, #paginationControls li span { display:flex; align-items:center; justify-content:center; min-width:32px; height:32px; padding:0 8px; border-radius:8px; font-size:.8rem; text-decoration:none; color:#475569; background:#fff; border:1px solid #e2e8f0; cursor:pointer; }
        #paginationControls li.active a { background:#2563eb; color:#fff; border-color:#2563eb; }
        #paginationControls li.disabled span, #paginationControls li.disabled a { color:#cbd5e1; cursor:default; pointer-events:none; }

        .modal-backdrop { display:none; position:fixed; inset:0; background:rgba(15,23,42,.25); z-index:1000; backdrop-filter:blur(2px); }
        .modal-backdrop.open { display:block; }
        .side-modal { position:fixed; top:0; right:-480px; width:460px; height:100vh; background:#fff; z-index:1001; display:flex; flex-direction:column; box-shadow:-4px 0 24px rgba(0,0,0,.08); transition:right .25s cubic-bezier(.4,0,.2,1); }
        .side-modal.open { right:0; }
        .side-modal-header { display:flex; align-items:center; justify-content:space-between; padding:22px 28px 18px; border-bottom:1px solid #f1f5f9; }
        .side-modal-header h2 { font-size:1.05rem; font-weight:700; color:#0f172a; margin:0; }
        .close-btn { background:none; border:none; cursor:pointer; color:#94a3b8; font-size:1.1rem; padding:4px; border-radius:6px; }
        .close-btn:hover { color:#0f172a; }
        .side-modal-body { flex:1; overflow-y:auto; padding:22px 28px; display:flex; flex-direction:column; gap:14px; }
        .side-modal-footer { padding:18px 28px; border-top:1px solid #f1f5f9; display:flex; justify-content:flex-end; gap:8px; }

        .form-group { display:flex; flex-direction:column; gap:5px; }
        .form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
        .form-group label { font-size:.72rem; font-weight:700; color:#6b7280; text-transform:uppercase; letter-spacing:.05em; }
        .label-hint { color:#94a3b8; font-weight:400; text-transform:none; }
        .form-group input { border:1px solid #e2e8f0; border-radius:8px; padding:9px 12px; font-size:.875rem; color:#0f172a; outline:none; }
        .form-group input:focus { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.08); }

        .file-drop { border:2px dashed #e2e8f0; border-radius:10px; padding:18px; display:flex; flex-direction:column; align-items:center; gap:6px; cursor:pointer; color:#94a3b8; font-size:.8rem; text-align:center; }
        .file-drop:hover { border-color:#2563eb; background:#eff6ff; color:#2563eb; }
        .file-drop.has-file { border-color:#10b981; background:#f0fdf4; color:#059669; }

        .existing-file-bar { align-items:center; justify-content:space-between; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:8px 12px; margin-top:6px; }
        .file-attached-label { font-size:.8rem; color:#059669; }
        .btn-remove-file { background:none; border:none; cursor:pointer; color:#dc2626; font-size:.78rem; font-weight:600; padding:2px 6px; border-radius:4px; }
        .btn-remove-file:hover { background:#fee2e2; }

        #toast { position:fixed; bottom:24px; right:24px; padding:12px 20px; border-radius:10px; font-size:.875rem; font-weight:500; transform:translateY(80px); opacity:0; transition:all .3s cubic-bezier(.4,0,.2,1); z-index:2000; pointer-events:none; }
        #toast.show { transform:translateY(0); opacity:1; }
        #toast.success { background:#0f172a; color:#fff; }
        #toast.error { background:#dc2626; color:#fff; }
    </style>
}
